import random
def dice(sides_of_dice):
    result = random.randint(1, sides_of_dice) #will give a random number between 1 and sides of dice)
    return result
def main():
    sides_of_dice = 6  #as there are 6 sides for a dice
    game_online = True  #this condition will check if the game is running
    while game_online:   #while the game online is true
        player_input = input("Ready to roll? Enter Q to Quit")
        if player_input.lower() !="q":#if the user input is not equals to q
            game_result = dice(sides_of_dice) #calling the initialized function
        else:
            game_online = False